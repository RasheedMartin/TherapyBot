# Required
SECRET_KEY=change-me
GROQ_API_KEY=

# Local development (needs Postgres with pgvector: brew install postgresql@17 pgvector; createdb therapybot)
DEBUG=true
# DATABASE_URL=postgres:///therapybot   # the default

# Clinical data. Leave PHI_ALLOWED off until hosting and AI providers are covered by BAAs.
# PHI_ALLOWED=false
# Fernet keys for encrypting clinical text at rest, newest first. Required once PHI_ALLOWED is on.
# FIELD_ENCRYPTION_KEYS=

# Production
# ALLOWED_HOSTS=api.example.com
# FRONTEND_URL=https://therapybot.example.com
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Email (password resets). Without EMAIL_HOST, emails are printed to the console.
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=TherapyBot <no-reply@example.com>

# Sign in with Google: OAuth client ID (Web application) from Google Cloud Console
# GOOGLE_CLIENT_ID=1234-abc.apps.googleusercontent.com

# Optional tuning
# GROQ_MODEL=openai/gpt-oss-120b
# THROTTLE_CHAT=20/min
# WEB_CONCURRENCY=2
